---
import { profile, experience, education, skills, projects, languages, certifications } from '../data/profile';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
const repoName = (url: string) => url.replace('https://github.com/', '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · {profile.role}</title>
    <meta name="description" content={profile.tagline} />
    <meta property="og:title" content={`${profile.name} · ${profile.role}`} />
    <meta property="og:description" content={profile.tagline} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={profile.website} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a href="#top" class="logo">~/francesco<span class="cursor">_</span></a>
        <nav>
          <a href="#projects">projects</a>
          <a href="#experience">experience</a>
          <a href="#skills">skills</a>
          <a href="#education">education</a>
          <a href="/cv" class="cv-link">cv</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero wrap">
        <p class="prompt"><span class="accent">$</span> whoami</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="tagline">{profile.tagline}</p>
        <p class="meta"><span class="accent">›</span> {profile.location} · MSc Data Science @ Milano-Bicocca</p>
        <div class="links">
          <a class="btn primary" href="/cv">View CV</a>
          <a class="btn primary" href="/cv.pdf" download>Download PDF</a>
          <a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub</a>
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn" href={`mailto:${profile.email}`}>Email</a>
        </div>
      </section>

      <section id="projects" class="wrap section">
        <h2><span class="accent">01.</span> projects</h2>
        <div class="grid">
          {
            featured.map((p) => (
              <article class="card">
                <div class="card-head">
                  <h3>{p.name}</h3>
                  {p.status && <span class="badge">{p.status}</span>}
                </div>
                <p>{p.summary}</p>
                {p.bullets.length > 0 && (
                  <ul>
                    {p.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
                <div class="tags">
                  {p.tech.map((t) => (
                    <span>{t}</span>
                  ))}
                </div>
                <a class="repo" href={p.repo} target="_blank" rel="noopener">
                  ↗ {repoName(p.repo)}
                </a>
              </article>
            ))
          }
        </div>

        <h3 class="sub">other projects</h3>
        <ul class="others">
          {
            others.map((p) => (
              <li>
                <a href={p.repo} target="_blank" rel="noopener">{p.name}</a>
                {p.status && <span class="badge">{p.status}</span>}
                <p>{p.summary}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="experience" class="wrap section">
        <h2><span class="accent">02.</span> experience</h2>
        <ol class="timeline">
          {
            experience.map((e) => (
              <li>
                <div class="t-head">
                  <h3>{e.role} <span class="at">@ {e.company}</span></h3>
                  <span class="period">{e.period}</span>
                </div>
                <ul>
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="skills" class="wrap section">
        <h2><span class="accent">03.</span> skills</h2>
        <div class="skills">
          {
            skills.map((s) => (
              <div class="skill-group">
                <h3>{s.group.toLowerCase()}</h3>
                <div class="tags">
                  {s.items.map((i) => (
                    <span>{i}</span>
                  ))}
                </div>
              </div>
            ))
          }
          <div class="skill-group">
            <h3>languages</h3>
            <div class="tags">
              {languages.map((l) => <span>{l.name} · {l.level.split(';')[0]}</span>)}
            </div>
          </div>
        </div>
      </section>

      <section id="education" class="wrap section">
        <h2><span class="accent">04.</span> education</h2>
        <ol class="timeline">
          {
            education.map((e) => (
              <li>
                <div class="t-head">
                  <h3>{e.degree} <span class="at">@ {e.school}</span></h3>
                  <span class="period">{e.period}</span>
                </div>
                {e.details && <p class="muted">{e.details.join(' ')}</p>}
              </li>
            ))
          }
        </ol>
        <p class="muted certs"><span class="accent">certifications:</span> {certifications.join(' · ')}</p>
      </section>

      <section id="contact" class="wrap section contact">
        <h2><span class="accent">05.</span> contact</h2>
        <p>Open to Data Scientist and ML/AI Engineer opportunities. The fastest way to reach me is email.</p>
        <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
      </section>
    </main>

    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>built with Astro · <a href="https://github.com/frabanfo/frabanfo.github.io" target="_blank" rel="noopener">source</a></span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0f14;
    --surface: #111821;
    --border: #1f2a36;
    --text: #d6deeb;
    --muted: #8b98a9;
    --accent: #4ade80;
    --accent-2: #38bdf8;
    --mono: 'JetBrains Mono', ui-monospace, Consolas, monospace;
    --sans: 'Inter', system-ui, -apple-system, Segoe UI, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 72px; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent-2); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 16px; }
  .accent { color: var(--accent); }
  .muted { color: var(--muted); }

  .nav {
    position: sticky; top: 0; z-index: 10;
    background: rgba(11, 15, 20, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; gap: 16px; }
  .logo { font-family: var(--mono); font-weight: 700; color: var(--text); }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  nav { display: flex; gap: 18px; font-family: var(--mono); font-size: 0.85rem; overflow-x: auto; }
  nav a { color: var(--muted); white-space: nowrap; }
  nav a:hover { color: var(--accent); text-decoration: none; }
  nav .cv-link { color: var(--accent); }

  .hero { padding: 96px 16px 72px; }
  .prompt { font-family: var(--mono); color: var(--muted); margin: 0 0 8px; }
  h1 { font-family: var(--mono); font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.1; margin: 0; letter-spacing: -0.02em; }
  .role { font-family: var(--mono); color: var(--accent); font-size: clamp(1rem, 2.5vw, 1.25rem); margin: 12px 0 20px; }
  .tagline { max-width: 640px; font-size: 1.1rem; margin: 0 0 12px; }
  .meta { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); margin: 0 0 28px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn {
    display: inline-block; padding: 8px 16px; border: 1px solid var(--border); border-radius: 6px;
    font-family: var(--mono); font-size: 0.85rem; color: var(--text); background: var(--surface);
    transition: border-color 0.15s, color 0.15s;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .btn.primary { border-color: var(--accent); color: var(--accent); }

  .section { padding: 56px 16px; border-top: 1px solid var(--border); }
  h2 { font-family: var(--mono); font-size: 1.4rem; margin: 0 0 28px; }
  h3 { font-size: 1.05rem; margin: 0; }
  .sub { font-family: var(--mono); color: var(--muted); font-weight: 500; margin: 40px 0 16px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: 16px; }
  .card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px;
    display: flex; flex-direction: column; gap: 10px; transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: #2f4a3a; transform: translateY(-2px); }
  .card p { margin: 0; color: var(--muted); }
  .card ul, .timeline ul { margin: 0; padding-left: 18px; font-size: 0.93rem; }
  .card li, .timeline li li { margin-bottom: 4px; }
  .card-head { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
  .badge {
    font-family: var(--mono); font-size: 0.7rem; color: #fbbf24; border: 1px solid #5c4813;
    border-radius: 999px; padding: 1px 8px; white-space: nowrap; margin-left: 8px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span {
    font-family: var(--mono); font-size: 0.75rem; color: var(--accent);
    background: rgba(74, 222, 128, 0.08); border-radius: 4px; padding: 2px 8px;
  }
  .repo { font-family: var(--mono); font-size: 0.8rem; margin-top: auto; padding-top: 4px; }

  .others { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .others a { font-weight: 600; }
  .others p { margin: 2px 0 0; color: var(--muted); font-size: 0.93rem; }

  .timeline { list-style: none; padding: 0 0 0 20px; margin: 0; border-left: 2px solid var(--border); }
  .timeline > li { position: relative; padding-bottom: 28px; }
  .timeline > li::before {
    content: ''; position: absolute; left: -27px; top: 6px; width: 12px; height: 12px;
    border-radius: 50%; background: var(--bg); border: 2px solid var(--accent);
  }
  .t-head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; margin-bottom: 6px; }
  .at { color: var(--accent-2); font-weight: 500; }
  .period { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); }
  .timeline p { margin: 0; }
  .certs { margin-top: 8px; font-family: var(--mono); font-size: 0.85rem; }

  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 24px; }
  .skill-group h3 { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); font-weight: 500; margin-bottom: 10px; }

  .contact p { max-width: 560px; }
  .footer {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    padding: 28px 16px 40px; border-top: 1px solid var(--border);
    font-family: var(--mono); font-size: 0.8rem; color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .cursor { animation: none; }
    .card, .card:hover { transition: none; transform: none; }
  }
  @media (max-width: 640px) {
    nav a:not(.cv-link) { display: none; }
    .hero { padding: 64px 16px 48px; }
  }
</style>
